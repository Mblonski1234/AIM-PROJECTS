# Copy to .env for local dev:  cp .env.example .env
# (Never commit .env — it's gitignored.)

# Shared access password students type on the login screen.
SITE_PASSWORD=aim-demo

# Random string used to sign the login cookie. Generate a long random value.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Cloudflare R2 (leave blank to run in local demo mode) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
